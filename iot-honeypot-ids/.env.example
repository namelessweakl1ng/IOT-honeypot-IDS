# =====================================================================
# Project-wide environment template.
# Copy to `.env` per machine and edit. Never commit the real `.env`.
# =====================================================================

# ---- Topology -------------------------------------------------------
# IP of the Raspberry Pi honeypot. Used by PC2 (attacker) and PC1 (display).
PI_IP=192.168.1.50

# IP of Computer 1 (ELK + ML + API + dashboard). Used by the Pi (Filebeat) and PC2 (attacker).
CENTRAL_SERVER_IP=192.168.1.10

# IP of Computer 2 (attacker). Used by the demo orchestrator on PC1.
ATTACKER_IP=192.168.1.20

# Lab subnet in CIDR. Attacker scripts refuse targets outside this subnet.
LAB_SUBNET=192.168.1.0/24

# ---- Honeypot enabling flags (Pi side) -----------------------------
ENABLE_COWRIE=true
ENABLE_CAMERA=true
ENABLE_IOT_SERVICE=true

# Honeypot listening ports (must be free on the Pi)
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
CAMERA_HTTP_PORT=8080
IOT_SERVICE_PORT=9000

# ---- ELK / API ports (PC1 side) ------------------------------------
ELASTICSEARCH_PORT=9200
LOGSTASH_BEATS_PORT=5044
LOGSTASH_HTTP_PORT=9600
KIBANA_PORT=5601
API_PORT=8000

# Pinned Elastic stack version (kept aligned across components)
ELK_VERSION=8.13.4

# ---- Security -------------------------------------------------------
# Change all of these before deploying.
ELASTIC_PASSWORD=changeme-elastic
KIBANA_SYSTEM_PASSWORD=changeme-kibana
LOGSTASH_SYSTEM_PASSWORD=changeme-logstash
LOGSTASH_BEATS_PASSWORD=changeme-beats

# A random 32-byte hex string. Generate with: openssl rand -hex 32
# This is the FastAPI backend's API key — required for all mutating endpoints
# (honeypot start/stop/restart, training, replay).
API_SECRET_KEY=replace-with-openssl-rand-hex-32

# The Next.js server reads this to forward to FastAPI as the X-API-Key header.
# It MUST match API_SECRET_KEY on the FastAPI backend.
# The browser NEVER sees this value — it is server-side only.
# If unset, Next.js falls back to API_SECRET_KEY (above) for backwards compat.
TRAPSIG_BACKEND_API_KEY=replace-with-openssl-rand-hex-32

# ---- Pi: SSH management ---------------------------------------------
# Username on the Pi used for remote administration.
# REQUIRED when a Pi is deployed. Empty / unset → backend reports pi_status=NOT_CONFIGURED.
PI_SSH_USER=pi

# Pi IP address. REQUIRED when a Pi is deployed. Empty / unset → NOT_CONFIGURED.
PI_IP=192.168.1.50

# Path to the SSH private key used by the FastAPI backend to manage the Pi.
# Optional but recommended — if unset, ssh falls back to the user's default keyring.
# PI_SSH_KEY=/app/ssh-keys/id_ed25519

# Path to the known_hosts file used to verify the Pi's host key.
# Generate on first run with: ssh-keyscan -t ed25519,rsa,ecdsa $PI_IP >> $PI_KNOWN_HOSTS
# PI_KNOWN_HOSTS=/app/known_hosts

# Lab bootstrap: set to 1 to allow StrictHostKeyChecking=accept-new on the FIRST
# connection only. Subsequent host-key mismatches STILL fail. Safer than "no".
# Leave at 0 in production — operator should pre-seed known_hosts.
PI_SSH_ACCEPT_NEW_HOST_KEY=0

# SSH timeouts (seconds) — keep small to fail fast.
PI_SSH_CONNECT_TIMEOUT=3
PI_SSH_COMMAND_TIMEOUT=15

# Path on the Pi to the docker-compose.yml for honeypot containers.
PI_DEPLOY_PATH=~/iot-honeypot-ids/pi

# ---- PCAP capture ---------------------------------------------------
# If true, the Pi runs tcpdump in a constrained container.
# Leave false unless you have plenty of SD card space.
ENABLE_PCAP=false
PCAP_RETENTION_HOURS=24

# ---- ML / data paths (PC1) ----------------------------------------
# Use relative paths from the project root, or absolute paths to suit your host.
DATA_PATH=./data
MODEL_PATH=./model-lab/models

# ---- Misc -----------------------------------------------------------
# Comma-separated list of honeypot device ids shown in dashboards
DEVICE_IDS=cowrie-01,camera-01,iot-01

# Log level for the API and ML services: DEBUG INFO WARNING ERROR
LOG_LEVEL=INFO

# Timezone for display (telemetry timestamps are always UTC ISO-8601)
DISPLAY_TZ=UTC
