# ------------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------
# Python
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------
# Node / Frontend
# ------------------------------------------------------------------
node_modules/
dashboard/frontend/dist/
dashboard/frontend/build/
.npm
.pnpm-store/
.yarn/

# ------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------
# never commit data volumes
dashboard/elasticsearch/data/
dashboard/logstash/data/
pi/honeypots/cowrie/var/
pi/honeypots/cowrie/etc/users/
pi/collector/data/

# ------------------------------------------------------------------
# Captured attacker data (sensitive)
# ------------------------------------------------------------------
*.pcap
*.pcapng
*.cap
captured_credentials/
captured_files/
downloads/

# ------------------------------------------------------------------
# Trained models (often large)
# ------------------------------------------------------------------
model-lab/models/*/model.pkl
model-lab/models/*/model.joblib
model-lab/models/*/model.pt
model-lab/models/*/model.h5
# keep the metadata / README so the registry still works
!model-lab/models/*/metadata.json
!model-lab/models/*/README.md

# datasets that are too large for git
model-lab/datasets/raw/
model-lab/datasets/*.parquet
model-lab/datasets/*.csv.gz
research/datasets/iot23/raw/
research/datasets/iot23/archive/
research/datasets/iot23/prepared/
research/datasets/iot23/manifest.json
research/datasets/iot23/summary.md
research/experiments/iot23/

# ------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------
*.log
logs/
pi/logs/
dashboard/logs/

# ------------------------------------------------------------------
# SSH / keys
# ------------------------------------------------------------------
*.pem
*.key
*.pub
id_rsa
id_ed25519
.ssh/

# ------------------------------------------------------------------
# IDE / OS
# ------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ------------------------------------------------------------------
# Local Kibana saved objects exports (optional)
# ------------------------------------------------------------------
dashboard/kibana/saved-objects/*.local.ndjson
