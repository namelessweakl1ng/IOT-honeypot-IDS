{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trapsig.local/schemas/iot23-manifest.schema.json",
  "title": "Measured IoT-23 preparation manifest",
  "type": "object",
  "required": ["dataset_name", "dataset_version", "data_category", "source_file_count", "source_checksum", "prepared_jsonl_sha256", "record_count", "scenario_count", "scenario_distribution", "original_label_distribution", "project_label_distribution", "binary_label_distribution", "feature_version", "label_source", "generated_at_utc", "verification_status"],
  "properties": {
    "dataset_name": {"const": "IoT-23"},
    "dataset_version": {"const": "1.0.0"},
    "data_category": {"const": "PUBLIC_DATASET"},
    "source_file_count": {"type": "integer", "minimum": 1},
    "source_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prepared_jsonl_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "scenario_count": {"const": 23},
    "scenario_distribution": {"type": "object", "minProperties": 23},
    "original_label_distribution": {"type": "object", "minProperties": 1},
    "project_label_distribution": {"type": "object", "minProperties": 1},
    "binary_label_distribution": {"type": "object", "minProperties": 1},
    "feature_version": {"const": "iot23-flow-v1"},
    "label_source": {"const": "EXTERNAL_DATASET"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "verification_status": {"const": "PREPARED_FROM_LOCAL_DATA"}
  },
  "additionalProperties": true
}
