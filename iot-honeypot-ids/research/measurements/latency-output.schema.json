{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRAPSIG measured latency artifact",
  "type": "object",
  "required": ["status", "data_category", "context", "clock_sync_status", "software_commit", "stages", "adjacent_durations_ms"],
  "properties": {
    "status": {"enum": ["MEASURED", "PARTIAL", "NOT RUN"]},
    "data_category": {"const": "CONTROLLED_LAB"},
    "clock_sync_status": {"enum": ["synchronized", "unsynchronized", "unknown"]},
    "software_commit": {"type": "string"},
    "stages": {"type": "object", "required": ["T0", "T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "T9"]},
    "adjacent_durations_ms": {"type": "object"}
  }
}
