# =====================================================================
# Pi-side environment template.
# Copy to `.env` and edit. Never commit the real `.env`.
# =====================================================================

# ---- Topology -------------------------------------------------------
# IP of Computer 1 (receives telemetry). Required.
CENTRAL_SERVER_IP=192.168.1.10

# Logstash Beats input port on PC1.
LOGSTASH_BEATS_PORT=5044

# ---- Honeypot enable flags ----------------------------------------
ENABLE_COWRIE=true
ENABLE_CAMERA=true
ENABLE_IOT_SERVICE=true

# ---- Listening ports (must be free on the Pi) ----------------------
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
CAMERA_HTTP_PORT=8080
IOT_SERVICE_PORT=9000

# ---- Device identity (used in telemetry) ---------------------------
DEVICE_ID_COWRIE=cowrie-01
DEVICE_ID_CAMERA=camera-01
DEVICE_ID_IOT=iot-01
HONEYPOT_HOSTNAME=iot-bridge-01

# ---- Cowrie tuning --------------------------------------------------
# Output format must stay JSON so Filebeat can parse it cleanly.
COWRIE_LOG_FORMAT=json
COWRIE_JSON_LOG=/var/log/cowrie/cowrie.json

# ---- PCAP (optional, off by default) ------------------------------
ENABLE_PCAP=false
PCAP_RETENTION_HOURS=24

# ---- Filebeat / Elastic stack version (must match PC1) -------------
ELK_VERSION=8.13.4
LOGSTASH_BEATS_PASSWORD=REPLACE_WITH_UNIQUE_LOCAL_LAB_SECRET

# ---- Resource limits (MB) ------------------------------------------
# Adjusted for a 4 GB Pi 4 with headroom for SSH admin.
COWRIE_MEM_LIMIT=256M
CAMERA_MEM_LIMIT=96M
IOT_SERVICE_MEM_LIMIT=64M
FILEBEAT_MEM_LIMIT=96M
COLLECTOR_MEM_LIMIT=64M

# ---- Log level for the camera and iot-service ----------------------
LOG_LEVEL=INFO
