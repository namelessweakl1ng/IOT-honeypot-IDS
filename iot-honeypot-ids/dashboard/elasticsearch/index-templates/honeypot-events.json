{
  "index_patterns": ["honeypot-events-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.lifecycle.name": "honeypot-events-policy"
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "@timestamp":     { "type": "date" },
        "ingested_at":    { "type": "date" },
        "timestamp_source": { "type": "keyword" },
        "event_id":       { "type": "keyword" },
        "session_id":     { "type": "keyword" },

        "source": {
          "properties": {
            "ip":   { "type": "ip" },
            "port": { "type": "integer" }
          }
        },
        "destination": {
          "properties": {
            "ip":   { "type": "ip" },
            "port": { "type": "integer" }
          }
        },
        "device": {
          "properties": {
            "id":       { "type": "keyword" },
            "type":     { "type": "keyword" },
            "hostname": { "type": "keyword" },
            "container": { "type": "keyword" }
          }
        },
        "protocol":   { "type": "keyword" },

        "event": {
          "properties": {
            "type":     { "type": "keyword" },
            "category": { "type": "keyword" },
            "action":   { "type": "keyword" },
            "note":     { "type": "text" }
          }
        },

        "authentication": {
          "properties": {
            "attempted": { "type": "boolean" },
            "username":  { "type": "keyword" },
            "success":   { "type": "boolean" }
          }
        },

        "http": {
          "properties": {
            "method":        { "type": "keyword" },
            "uri":           { "type": "keyword" },
            "status":        { "type": "integer" },
            "user_agent":    { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "bytes_in":      { "type": "long" },
            "bytes_out":     { "type": "long" },
            "body_preview":  { "type": "text", "index": false }
          }
        },

        "network": {
          "properties": {
            "bytes_in":  { "type": "long" },
            "bytes_out": { "type": "long" }
          }
        },

        "honeypot": {
          "properties": {
            "name":      { "type": "keyword" },
            "container": { "type": "keyword" }
          }
        },

        "attack": {
          "properties": {
            "session_id":     { "type": "keyword" },
            "stage":          { "type": "keyword" },
            "classification": { "type": "keyword" },
            "confidence":     { "type": "float" }
          }
        },

        "tags":  { "type": "keyword" },
        "labels": { "type": "object", "enabled": false }
      }
    }
  },
  "priority": 100,
  "_meta": {
    "description": "Honeypot events (cowrie/camera/iot-service). Pinned to ECS-like fields."
  }
}
