{
  "index_patterns": ["honeypot-detections-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "@timestamp":              { "type": "date" },
        "session_id":              { "type": "keyword" },
        "campaign_id":             { "type": "keyword" },
        "detection_id":            { "type": "keyword" },
        "engine":                  { "type": "keyword" },
        "detector_version":        { "type": "keyword" },
        "rule_id":                 { "type": "keyword" },
        "label":                   { "type": "keyword" },
        "classification":          { "type": "keyword" },
        "severity":                { "type": "keyword" },
        "confidence":              { "type": "float" },
        "anomaly_score":           { "type": "float" },
        "threshold":               { "type": "float" },
        "threshold_selection_method": { "type": "keyword" },
        "model_id":                { "type": "keyword" },
        "model_version":           { "type": "keyword" },
        "feature_schema_version":  { "type": "keyword" },
        "persisted":               { "type": "boolean" },
        "persistence_error":       { "type": "text", "index": false },
        "detector_config_fingerprint": { "type": "keyword" },
        "explanation":             { "type": "text" },
        "evidence":                { "type": "object", "enabled": false },
        "thresholds":              { "type": "object", "enabled": false },
        "source": {
          "properties": {
            "ip": { "type": "ip" }
          }
        },
        "device": {
          "properties": {
            "id": { "type": "keyword" }
          }
        }
      }
    }
  },
  "priority": 120,
  "_meta": {
    "description": "Detections emitted by rule engine + anomaly detector + hybrid detector + supervised ML."
  }
}
