# =====================================================================
# Computer 1 environment template (ELK + ML + API + frontend)
# Copy to `.env` and edit. Never commit the real `.env`.
# =====================================================================

# ---- Pi control plane (REQUIRED when a Pi is deployed) -------------
# Empty values → backend reports pi_status=NOT_CONFIGURED (never silent default)
PI_IP=192.168.1.50
PI_SSH_USER=pi
# PI_SSH_KEY=/app/ssh-keys/id_ed25519
# PI_KNOWN_HOSTS=/app/known_hosts
PI_SSH_ACCEPT_NEW_HOST_KEY=0
PI_SSH_CONNECT_TIMEOUT=3
PI_SSH_COMMAND_TIMEOUT=15
PI_DEPLOY_PATH=~/iot-honeypot-ids/pi

# ---- Topology -------------------------------------------------------
ATTACKER_IP=192.168.1.20
LAB_SUBNET=192.168.1.0/24

# ---- ELK ports ------------------------------------------------------
ELASTICSEARCH_PORT=9200
LOGSTASH_BEATS_PORT=5044
LOGSTASH_HTTP_PORT=9600
KIBANA_PORT=5601
API_PORT=8000
FRONTEND_PORT=3000

# Pinned Elastic stack version (all components must match)
ELK_VERSION=8.13.4

# ---- Security -------------------------------------------------------
# CHANGE THESE BEFORE ANY DEPLOYMENT.
ELASTIC_PASSWORD=changeme-elastic
KIBANA_SYSTEM_PASSWORD=changeme-kibana
LOGSTASH_SYSTEM_PASSWORD=changeme-logstash
LOGSTASH_BEATS_PASSWORD=changeme-beats

# 32-byte hex; generate with: openssl rand -hex 32
API_SECRET_KEY=replace-with-openssl-rand-hex-32

# Restrict the API to the lab subnet (comma-separated CIDRs)
API_ALLOWED_CIDRS=192.168.1.0/24,127.0.0.0/8

# ---- Heap sizing (tune for the host RAM) ---------------------------
ES_JAVA_OPTS=-Xms2g -Xmx2g
LS_JAVA_OPTS=-Xms1g -Xmx1g

# ---- Data / model paths --------------------------------------------
# Use relative paths from the project root, or absolute paths to suit your host.
DATA_PATH=./data
MODEL_PATH=./model-lab/models

# ---- ML defaults ----------------------------------------------------
DEFAULT_RANDOM_SEED=42
DEFAULT_TRAIN_TEST_SPLIT=0.2
# v2 = leakage-safe (excludes 3 label-derived features); v1 = legacy 25 features
DEFAULT_FEATURE_VERSION=v2

# ---- Logging --------------------------------------------------------
LOG_LEVEL=INFO
